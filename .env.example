# Copy this file to .env and fill in real secrets.
# Do not commit .env.

# App
APP_ENV=development
DEBUG=false
APP_NAME=AI Job Copilot
# Comma-separated frontend origins.
# Production must use HTTPS origins, for example:
# CORS_ALLOW_ORIGINS=https://app.example.com,https://www.example.com
CORS_ALLOW_ORIGINS=

# Backend database
# Leave DATABASE_URL unset to use the default local SQLite database.
# DATABASE_URL=sqlite+aiosqlite:///./data/ai_job_copilot.db
REDIS_URL=redis://localhost:6379/0

# JWT
# Development can omit JWT_SECRET; the backend will generate a temporary runtime secret.
# Production must set a stable random secret of at least 32 characters.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# Model API
# Prefer the generic LLM_* settings for new providers. The backend calls an
# OpenAI-compatible chat/completions API. Leave LLM_EMBEDDING_MODEL empty if
# the selected provider does not support embeddings; semantic search will fall
# back to keyword search.
LLM_PROVIDER=glm
LLM_API_KEY=your_api_key_here
LLM_CHAT_MODEL=glm-4.6V
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_EMBEDDING_MODEL=embedding-3

# Legacy GLM API fallback. Existing environments can keep using these, but new
# deployments should use LLM_* above.
GLM_API_KEY=your_api_key_here
GLM_MODEL=glm-4.6V
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_TEMPERATURE=0.7
GLM_MAX_TOKENS=4096
GLM_TIMEOUT_SECONDS=60
GLM_MAX_RETRIES=1
GLM_EMBEDDING_MODEL=embedding-3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
