# Copy this file to .env and fill in real secrets.
# Do not commit .env.

# App
APP_ENV=development
DEBUG=false
APP_NAME=AI Job Copilot

# Backend database
# Leave DATABASE_URL unset to use the default local SQLite database.
# DATABASE_URL=sqlite+aiosqlite:///./data/ai_job_copilot.db
REDIS_URL=redis://localhost:6379/0

# JWT
# Development can omit JWT_SECRET; the backend will generate a temporary runtime secret.
# Production must set a stable random secret of at least 32 characters.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# GLM API
GLM_API_KEY=your_api_key_here
GLM_MODEL=glm-4.6V
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_TEMPERATURE=0.7
GLM_MAX_TOKENS=4096

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
