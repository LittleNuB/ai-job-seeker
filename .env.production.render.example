# Render 环境变量示例
# DATABASE_URL 从 Render PostgreSQL Internal Connection String 复制

# ── 安全 ──
APP_ENV=production
JWT_SECRET=generate-a-strong-random-string-at-least-32-chars

# ── CORS ──
# Vercel 前端域名
CORS_ALLOW_ORIGINS=https://ai-jobcopilot.vercel.app

# ── GLM 模型 ──
GLM_API_KEY=your-glm-api-key
GLM_MODEL=GLM-4.5-AirX
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_TEMPERATURE=0.7
GLM_MAX_TOKENS=8192
GLM_TIMEOUT_SECONDS=120
GLM_MAX_RETRIES=1
