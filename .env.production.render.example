# Render 环境变量示例
# DATABASE_URL 从 Render PostgreSQL Internal Connection String 复制

# ── 安全 ──
APP_ENV=production
JWT_SECRET=generate-a-strong-random-string-at-least-32-chars

# ── CORS ──
# Vercel 前端域名
CORS_ALLOW_ORIGINS=https://ai-jobcopilot.vercel.app

# ── 模型配置 (DeepSeek V4 Flash) ──
GLM_API_KEY=your-deepseek-api-key
GLM_MODEL=deepseek-v4-flash
GLM_BASE_URL=https://api.deepseek.com
GLM_TEMPERATURE=0.2
GLM_MAX_TOKENS=8192
GLM_TIMEOUT_SECONDS=60
GLM_MAX_RETRIES=1
