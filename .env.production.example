# Copy to .env.production on the VPS and fill real values.
# Never commit .env.production.

# Public HTTPS site served by Caddy.
# Example: CADDY_SITE_ADDRESS=app.example.com
CADDY_SITE_ADDRESS=app.example.com

# Optional host ports. Keep 80/443 on VPS; override locally for smoke tests
# when those ports are occupied, for example 8088/8443.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# Optional image overrides. Keep the official defaults unless your VPS cannot
# reach Docker Hub reliably.
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine

# App
APP_ENV=production
DEBUG=false
APP_NAME=AI Job Copilot

# CORS must list the public frontend origin. With same-domain Caddy routing this
# is still required because production startup validates it.
CORS_ALLOW_ORIGINS=https://app.example.com

# PostgreSQL container
POSTGRES_DB=ai_job_copilot
POSTGRES_USER=ai_job
POSTGRES_PASSWORD=change-this-postgres-password

# The compose file injects DATABASE_URL from POSTGRES_* values.
# Keep this commented unless you intentionally use an external database.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/ai_job_copilot

# Redis container
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# Model API. Prefer LLM_* for new deployments.
LLM_PROVIDER=glm
LLM_API_KEY=change-this-model-provider-key
LLM_CHAT_MODEL=glm-4.6V
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_EMBEDDING_MODEL=embedding-3

# Frontend browser API base.
# Leave empty for same-domain /api routing through Caddy.
NEXT_PUBLIC_API_URL=
